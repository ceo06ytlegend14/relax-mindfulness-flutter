{
  "name": "sanctuary-quality-checks",
  "private": true,
  "description": "Development-only checks for Sanctuary's independent browser preview and release configuration.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:web": "node --test --test-timeout=180000 test/web/*.mjs",
    "test:platform": "node --test test/web/platform_config_test.mjs",
    "test:pwa": "node --test test/web/pwa_manifest_test.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
