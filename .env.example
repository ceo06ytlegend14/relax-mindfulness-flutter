# Guidance only: Flutter does not load this file automatically.
# Never put private credentials in Git or compile them into a production client.
# These are PUBLIC platform SDK keys, never a RevenueCat secret REST key.
# The former shared REVENUECAT_API_KEY setting is no longer consumed.
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
# New purchases stay OFF unless the owner deliberately enables a reviewed build.
# Restoring existing SDK entitlements does not require enabling new purchases.
ENABLE_STORE_PURCHASES=false
# Owner-approved, working public HTTPS pages are required for new purchases.
PRIVACY_POLICY_URL=
TERMS_URL=
# No AI provider key is consumed. Reflection studio is a local writing template,
# not a generative service. Future remote AI requires server-side credentials,
# consent, request authorization, rate limits and cost controls.
